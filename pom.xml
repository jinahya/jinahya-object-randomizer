  <artifactId>jinahya-object-randomizer</artifactId>
  <version>0.0.5</version>
  <packaging>jar</packaging>

  <name>${project.artifactId}</name>
  <description>
    Randomizes instances of arbitrary classes with PODAM, Instancio, or Fixture Monkey, behind one
    abstract class, with the randomizer of a target class located by a naming convention.
  </description>
  <url>https://github.com/jinahya/${project.artifactId}</url>
  <licenses>
    <license>
      <name>The Apache Software License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Jin Kwon</name>
      <email>onacit_at_gmail.com</email>
      <url>https://github.com/onacit</url>
    </developer>
  </developers>

  <scm>
    <url>https://github.com/jinahya/${project.artifactId}</url>
    <tag>0.0.5</tag>
  </scm>
  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/jinahya/${project.artifactId}/issues</url>
  </issueManagement>

  <properties>
<!--    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>-->
<!--    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>-->
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>${maven.compiler.source}</maven.compiler.target>
    <maven.compiler.release>${maven.compiler.target}</maven.compiler.release>
<!--    <maven.compiler.testSource>${maven.compiler.source}</maven.compiler.testSource>-->
    <maven.compiler.testSource>25</maven.compiler.testSource>
    <maven.compiler.testTarget>${maven.compiler.testSource}</maven.compiler.testTarget>
    <maven.compiler.testRelease>${maven.compiler.testSource}</maven.compiler.testRelease>
    <version.maven.compiler>3.16.0</version.maven.compiler>
    <version.maven.surefire>3.6.0</version.maven.surefire>
    <version.maven.failsafe>${version.maven.surefire}</version.maven.failsafe>
    <!-- the engines; each is provided, and a consumer brings exactly the one it uses -->
    <version.com.navercorp.fixturemonkey>1.2.3</version.com.navercorp.fixturemonkey>
    <version.org.instancio>6.1.0</version.org.instancio>
    <version.org.jeasy>6.0.1</version.org.jeasy>
    <version.uk.co.jemos.podam>8.0.2.RELEASE</version.uk.co.jemos.podam>

    <!-- Jakarta Bean Validation, its expression language, and its implementations, are test-scope only: no class
         here references the API, and an engine reads a target class's constraints reflectively. Every one of their
         versions is set by the two profiles active together, a jakarta-ee-NN and a jakarta-ee-NN-PROVIDER, and by
         nothing here, so that a build with either half missing has no version to fall back to; see <profiles>.
         The links, for when one of them moves:
         https://central.sonatype.com/artifact/jakarta.platform/jakarta.jakartaee-bom/versions
         https://central.sonatype.com/artifact/org.glassfish.expressly/expressly/versions
         https://central.sonatype.com/artifact/org.hibernate.validator/hibernate-validator/versions
         https://central.sonatype.com/artifact/org.apache.bval/bval-jsr/versions -->

    <version.org.jspecify>1.0.1</version.org.jspecify>

    <!-- adds the generation-specific test source root of the active jakarta-ee-NN profile -->
    <!-- https://central.sonatype.com/artifact/org.codehaus.mojo/build-helper-maven-plugin/versions -->
    <version.build-helper-maven-plugin>3.6.2</version.build-helper-maven-plugin>

    <version.ch.qos.logback>1.6.5</version.ch.qos.logback>
    <version.org.assertj>4.0.0-M1</version.org.assertj>
    <version.org.junit>6.1.3</version.org.junit>
    <version.org.mockito>5.24.0</version.org.mockito>
    <!-- test-scope only, and on the annotation processor path of the test compilation alone; see <build> -->
    <version.org.projectlombok>1.18.48</version.org.projectlombok>
    <version.org.slf4j>2.0.20</version.org.slf4j>
  </properties>

  <dependencyManagement>
    <!-- sorted by groupId, then artifactId -->
    <dependencies>
      <dependency>
        <groupId>jakarta.platform</groupId>
        <artifactId>jakarta.jakartaee-bom</artifactId>
        <version>${version.jakarta.jakartaee-bom}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-bom</artifactId>
        <version>${version.org.assertj}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${version.org.junit}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.mockito</groupId>
        <artifactId>mockito-bom</artifactId>
        <version>${version.org.mockito}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-bom</artifactId>
        <version>${version.org.slf4j}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <!-- sorted by groupId, then artifactId; what a scope means here:
         provided - the engines, and the annotations. Neither ObjectRandomizer nor AbstractObjectRandomizer
                    references an engine, and each flavor references only its own, so a consumer puts exactly one on
                    its classpath and the others are never loaded. Easy Random is among them although its flavor is
                    package-private: the class still compiles against the engine.
         test     - the test tooling, and everything Jakarta: no class in main references Jakarta Bean Validation,
                    and every Jakarta version, the expression language and the provider are pinned by the active
                    jakarta-ee-NN and jakarta-ee-NN-PROVIDER profiles; see <profiles>. -->
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <version>${version.ch.qos.logback}</version>
      <scope>test</scope>
    </dependency>
    <!-- engine -->
    <dependency>
      <groupId>com.navercorp.fixturemonkey</groupId>
      <artifactId>fixture-monkey</artifactId>
      <version>${version.com.navercorp.fixturemonkey}</version>
      <scope>provided</scope>
    </dependency>
    <!-- Fixture Monkey reads the constraints only through this plugin, which FixtureMonkeyObjectRandomizer looks up
         reflectively and registers when it is present; main does not compile against it, so this stays test-scoped.
         The other engines need no artifact of their own, which is why this is the one flavor whose constraint
         support is a dependency -->
    <dependency>
      <groupId>com.navercorp.fixturemonkey</groupId>
      <artifactId>fixture-monkey-jakarta-validation</artifactId>
      <version>${version.com.navercorp.fixturemonkey}</version>
      <scope>test</scope>
      <exclusions>
        <!-- the plugin declares a complete Jakarta EE 9 stack at compile scope. Each is excluded and replaced by the
             active profile's own: the API by the platform BOM, the expression language by Expressly, and the
             implementation by the provider the profile selects. Left in, Hibernate Validator 7 would be a second
             provider on the classpath of every apache-bval profile, and which of the two the default bootstrap
             resolves is not something the specification decides -->
        <exclusion>
          <groupId>jakarta.validation</groupId>
          <artifactId>jakarta.validation-api</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.glassfish</groupId>
          <artifactId>jakarta.el</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.hibernate.validator</groupId>
          <artifactId>hibernate-validator</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- main annotates its own parameters with constraints, which document a contract that the code checks by hand,
         so the API is provided rather than compile: an annotation whose class is absent is skipped, by javac and by
         reflection alike, and a consumer of Java SE alone needs nothing. Tests compile against it all the same, for
         the constraints an engine reads off a target class. Its version is the active jakarta-ee-NN profile's -->
    <dependency>
      <groupId>jakarta.validation</groupId>
      <artifactId>jakarta.validation-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
      <exclusions>
        <!-- assertj pins an older byte-buddy than mockito needs; let mockito's own version win. The exclusion is
             declared here, rather than in <dependencyManagement>, because assertj-bom is an import and an import
             carries no exclusions: only the versions it manages are read, and anything else on the entry is
             ignored. Dropping it would hand the resolution to declaration order, where org.assertj sorts ahead of
             org.mockito, and the older version would win -->
        <exclusion>
          <groupId>net.bytebuddy</groupId>
          <artifactId>byte-buddy</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- the expression language, and the provider, which is what checks that what an engine produced satisfies the
         constraints, are declared by the active profiles; see <profiles> -->
    <!-- engine -->
    <dependency>
      <groupId>org.instancio</groupId>
      <artifactId>instancio-core</artifactId>
      <version>${version.org.instancio}</version>
      <scope>provided</scope>
    </dependency>
    <!-- engine -->
    <dependency>
      <groupId>org.jeasy</groupId>
      <artifactId>easy-random</artifactId>
      <version>${version.org.jeasy}</version>
      <scope>provided</scope>
    </dependency>
    <!-- CLASS-retention annotations; no consumer needs them at run time -->
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <version>${version.org.jspecify}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- the annotations only; the processor which acts on them is put on the processor path of the test
         compilation, in <build>, and never on the compile classpath -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>${version.org.projectlombok}</version>
      <scope>test</scope>
    </dependency>
    <!-- routes the java.lang.System.Logger which main logs through to SLF4J, and so to Logback; this is the bridge,
         not the SLF4J API, which logback-classic brings of its own accord -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-jdk-platform-logging</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- engine -->
    <dependency>
      <groupId>uk.co.jemos.podam</groupId>
      <artifactId>podam</artifactId>
      <version>${version.uk.co.jemos.podam}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${version.maven.compiler}</version>
        <executions>
          <!-- Lombok is put on the processor path of the test compilation, and of that one alone: no class under
               src/main uses it, and a processor path declared on the plugin rather than on an execution would apply
               to the main compilation too. Declaring the path at all is also what enables annotation processing,
               since javac runs no processor it merely finds on the classpath, so the main compilation goes on
               running with no processor at all, which is what it wants. -->
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <annotationProcessorPaths>
                <path>
                  <groupId>org.projectlombok</groupId>
                  <artifactId>lombok</artifactId>
                  <version>${version.org.projectlombok}</version>
                </path>
              </annotationProcessorPaths>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <configuration>
          <!-- @apiNote, @implSpec and @implNote are documented by JEP 8068562, yet the standard
               doclet registers none of them for code outside the JDK: left alone, every one of
               them is rejected as an "unknown tag". They are registered here, in the order, and
               with the headings, the JDK itself uses. -->
          <tags>
            <tag>
              <name>apiNote</name>
              <placement>a</placement>
              <head>API Note:</head>
            </tag>
            <tag>
              <name>implSpec</name>
              <placement>a</placement>
              <head>Implementation Requirements:</head>
            </tag>
            <tag>
              <name>implNote</name>
              <placement>a</placement>
              <head>Implementation Note:</head>
            </tag>
          </tags>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${version.maven.surefire}</version>
        <configuration>
          <systemPropertyVariables>
            <jakarta.validation.spec.version>${jakarta.validation.spec.version}</jakarta.validation.spec.version>
            <jakarta.validation.provider>${jakarta.validation.provider}</jakarta.validation.provider>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <!-- fails the build, in the validate phase, unless a jakarta-ee-NN-PROVIDER is active, and of the generation of
           the jakarta-ee-NN beside it. A build with no jakarta-ee-NN never gets this far: the BOM it imports has no
           version, and Maven rejects the model first; see <profiles> -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-jakarta-ee-profiles</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireProperty>
                  <property>jakarta.validation.provider.ee.version</property>
                  <message>no jakarta-ee-NN-PROVIDER profile is active; activate one, beside a jakarta-ee-NN, e.g. -Pjakarta-ee-11,jakarta-ee-11-hibernate-validator</message>
                  <regex>${jakarta.ee.version}</regex>
                  <regexMessage>the jakarta-ee-NN-PROVIDER profile active is of Jakarta EE ${jakarta.validation.provider.ee.version}, and the jakarta-ee-NN one of Jakarta EE ${jakarta.ee.version}; activate the two of one generation</regexMessage>
                </requireProperty>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- adds src/test/java-jakarta-ee-NN, of the active profile's generation, as a test source root -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>${version.build-helper-maven-plugin}</version>
        <executions>
          <execution>
            <id>add-test-source-jakarta-ee</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>src/test/java-jakarta-ee-${jakarta.ee.version}</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- ======================================= Jakarta EE generation ======================= -->
    <!-- Two implementation axes, both test-only ones: nothing in main references Jakarta Bean
         Validation. They are two kinds of profile, and a build activates one of each, of the
         same generation:

           -Pjakarta-ee-10,jakarta-ee-10-apache-bval

         jakarta-ee-NN is the GENERATION, and is not meant to be active alone. It sets what
         every provider of the generation shares: the platform BOM, which pins both
         jakarta.validation-api and jakarta.el-api; Expressly, the expression language under
         either provider; and src/test/java-jakarta-ee-NN, the test source root compiled, where
         everything belonging to a specification lives. The generations share nothing, even
         where two copies have the same signature, so that one specification can move without
         disturbing the other.

         jakarta-ee-NN-PROVIDER is the one implementation put on the test classpath: Hibernate
         Validator, the reference implementation, or Apache BVal, at the release aligned with
         the generation. The tests reach it only through the default bootstrap, so they do not
         change with it; surefire hands its class name in, and a test asserts it is the one,
         and only, provider found.

         jakarta-ee-11 and jakarta-ee-11-hibernate-validator are active when no profile is
         named; naming any profile turns both off, so a build names both of its two. One with
         no jakarta-ee-NN fails as Maven builds the model, the BOM having no version; one with
         no jakarta-ee-NN-PROVIDER, or with two of different generations, fails on the
         enforcer. -->
    <profile>
      <id>jakarta-ee-11</id>
      <!-- https://jakarta.ee/specifications/platform/11/ -->
      <!-- the BOM 11.0.0 manages jakarta.validation-api 3.1.1 and jakarta.el-api 6.0.1 -->
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <jakarta.ee.version>11</jakarta.ee.version>
        <version.jakarta.jakartaee-bom>11.0.0</version.jakarta.jakartaee-bom>
        <jakarta.validation.spec.version>3.1</jakarta.validation.spec.version>
        <version.org.glassfish.expressly>6.0.0</version.org.glassfish.expressly>
      </properties>
      <dependencies>
        <dependency>
          <groupId>org.glassfish.expressly</groupId>
          <artifactId>expressly</artifactId>
          <version>${version.org.glassfish.expressly}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>jakarta-ee-10</id>
      <!-- https://jakarta.ee/specifications/platform/10/ -->
      <!-- the BOM 10.0.0 manages jakarta.validation-api 3.0.2 and jakarta.el-api 5.0.1 -->
      <properties>
        <jakarta.ee.version>10</jakarta.ee.version>
        <version.jakarta.jakartaee-bom>10.0.0</version.jakarta.jakartaee-bom>
        <jakarta.validation.spec.version>3.0</jakarta.validation.spec.version>
        <version.org.glassfish.expressly>5.0.0</version.org.glassfish.expressly>
      </properties>
      <dependencies>
        <dependency>
          <groupId>org.glassfish.expressly</groupId>
          <artifactId>expressly</artifactId>
          <version>${version.org.glassfish.expressly}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
    <!-- ======================================= Jakarta Validation provider ================= -->
    <profile>
      <id>jakarta-ee-11-hibernate-validator</id>
      <!-- hibernate-validator 9 implements Jakarta Validation 3.1 -->
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <jakarta.validation.provider.ee.version>11</jakarta.validation.provider.ee.version>
        <jakarta.validation.provider>org.hibernate.validator.HibernateValidator</jakarta.validation.provider>
        <version.org.hibernate.validator>9.1.4.Final</version.org.hibernate.validator>
      </properties>
      <dependencies>
        <dependency>
          <groupId>org.hibernate.validator</groupId>
          <artifactId>hibernate-validator</artifactId>
          <version>${version.org.hibernate.validator}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>jakarta-ee-11-apache-bval</id>
      <!-- bval-jsr 3.1 implements Jakarta Validation 3.1 -->
      <properties>
        <jakarta.validation.provider.ee.version>11</jakarta.validation.provider.ee.version>
        <jakarta.validation.provider>org.apache.bval.jsr.ApacheValidationProvider</jakarta.validation.provider>
        <version.org.apache.bval>3.1.0</version.org.apache.bval>
      </properties>
      <dependencies>
        <dependency>
          <groupId>org.apache.bval</groupId>
          <artifactId>bval-jsr</artifactId>
          <version>${version.org.apache.bval}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>jakarta-ee-10-hibernate-validator</id>
      <!-- hibernate-validator 8 implements Jakarta Validation 3.0 -->
      <properties>
        <jakarta.validation.provider.ee.version>10</jakarta.validation.provider.ee.version>
        <jakarta.validation.provider>org.hibernate.validator.HibernateValidator</jakarta.validation.provider>
        <version.org.hibernate.validator>8.0.5.Final</version.org.hibernate.validator>
      </properties>
      <dependencies>
        <dependency>
          <groupId>org.hibernate.validator</groupId>
          <artifactId>hibernate-validator</artifactId>
          <version>${version.org.hibernate.validator}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>jakarta-ee-10-apache-bval</id>
      <!-- bval-jsr 3.0.1 and later implement Jakarta Validation 3.0; 3.0.0's manifest still declares 2.0 -->
      <properties>
        <jakarta.validation.provider.ee.version>10</jakarta.validation.provider.ee.version>
        <jakarta.validation.provider>org.apache.bval.jsr.ApacheValidationProvider</jakarta.validation.provider>
        <version.org.apache.bval>3.0.2</version.org.apache.bval>
      </properties>
      <dependencies>
        <dependency>
          <groupId>org.apache.bval</groupId>
          <artifactId>bval-jsr</artifactId>
          <version>${version.org.apache.bval}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
